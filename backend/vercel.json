{
  "version": 2,
  "alias": [
    "leadgenengineplatform-api.vercel.app"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/sequences/process-cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/sequences/check-replies",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/scrape-github",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/sequences/warmup-cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/scrape-hn",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/enrich-contacts",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/refresh-contacts",
      "schedule": "0 5 * * 0"
    }
  ]
}