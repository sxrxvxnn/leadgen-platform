{
  "version": 2,
  "alias": ["leadgenengineplatform-api.vercel.app"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/sequences/process-cron",
      "schedule": "0 */6 * * *"
    }
  ]
}
