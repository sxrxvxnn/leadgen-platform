# Copy to .env and fill in real values. Never commit .env to git.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key — used for auth operations (login, signup, token verification)
SUPABASE_ANON_KEY=get-this-from-supabase-dashboard-settings-api
# Service role key — used ONLY for server-side data operations, never exposed to frontend
SUPABASE_SERVICE_KEY=get-this-from-supabase-dashboard-settings-api

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://sonarleads.vercel.app
# Where Supabase redirects after a password reset email link is clicked
PASSWORD_RESET_REDIRECT_URL=https://sonarleads.vercel.app/reset-password

# ── PostHog ─────────────────────────────────────────────────────────────────
POSTHOG_PROJECT_TOKEN=get-this-from-posthog-project-settings
POSTHOG_HOST=https://us.i.posthog.com

# ── Optional API keys ────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── AWS (for SQS on K8s) ────────────────────────────────────────────────────
AWS_REGION=us-east-1
SQS_BULK_ENRICHMENT_URL=
SQS_BULK_MAPS_ENRICH_URL=
SQS_BULK_ANALYZE_URL=
SQS_BATCH_DM_URL=
